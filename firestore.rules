rules_version = '2';

// Proof. Finance — regras de segurança Firestore.
//
// Modelo de dados: a app guarda TODO o estado de cada utilizador num único
// documento `users/{uid}` (ver src/firebase/client.js → loadUserDoc/saveUserDoc).
// Não há subcoleções. Cada save é um setDoc(..., { merge: true }) que inclui
// `updatedAt: serverTimestamp()`.
//
// Regra: um utilizador autenticado só pode ler e escrever o SEU próprio
// documento (o id do documento tem de ser igual ao uid do token de auth).
// Tudo o resto é negado por omissão.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

  }
}
