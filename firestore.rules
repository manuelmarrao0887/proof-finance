rules_version = '2';

// Proof. Finance — regras de segurança Firestore.
//
// Modelo de dados (SUBCOLEÇÕES, ver src/firebase/data.js):
//   users/{uid}                  ← definições (theme, fxRates, pin, housing, …)
//     accounts/{id}              ← contas + cartões
//     movements/{id}             ← despesas/movimentos
//     incomes/{id} · balances/{id} · categories/{id} · transfers/{id}
//     goals/{id} · recurring/{id} · positions/{id} · rules/{id}
//
// Regra: um utilizador autenticado só lê/escreve os SEUS dados — o doc raiz E
// todas as subcoleções. O bloco `match /{sub}/{docId}` é ESSENCIAL: sem ele o
// `match /users/{uid}` sozinho NÃO cobre subcoleções e a app dá
// "Missing or insufficient permissions". Tudo o resto é negado por omissão.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /{sub}/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

  }
}
